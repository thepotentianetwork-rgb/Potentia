{
  "rewrites": [
    {
      "source": "/dropzone/api/:path*",
      "destination": "https://potentia-dropzone.thepotentianetwork.workers.dev/dropzone/api/:path*"
    },
    {
      "source": "/dropzone/uploads/:path*",
      "destination": "https://potentia-dropzone.thepotentianetwork.workers.dev/dropzone/uploads/:path*"
    },
    {
      "source": "/dropzone",
      "destination": "/dropzone/submit.html"
    },
    {
      "source": "/dropzone/crm",
      "destination": "/dropzone/submit.html"
    },
    {
      "source": "/dropzone/website",
      "destination": "/dropzone/submit.html"
    },
    {
      "source": "/dropzone/review",
      "destination": "/dropzone/review.html"
    },
    {
      "source": "/contractorform",
      "destination": "/contractorform.html"
    },
    {
      "source": "/businessform",
      "destination": "/businessform.html"
    }
  ],
  "redirects": [
    {
      "source": "/pricing(.html)?",
      "destination": "/portfolio.html",
      "permanent": false
    },
    {
      "source": "/sample(.html)?",
      "destination": "/portfolio.html",
      "permanent": false
    },
    {
      "source": "/contact(.html)?",
      "destination": "/",
      "permanent": false
    }
  ]
}